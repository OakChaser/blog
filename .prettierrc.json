{
    "semi": false,
    "tabWidth": 4,
    "printWidth": 100,
    "useTabs": false,
    "singleQuote": false,
    "bracketSameLine": true,
    "plugins": ["prettier-plugin-lint-md"],
    "overrides": [
        {
            "files": ["*.vue", "*.html", "*.yml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.vue"],
            "options": {
                "semi": true
            }
        }
    ]
}
